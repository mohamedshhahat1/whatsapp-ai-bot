# Rendered by the nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf at container start. Only ${DOMAIN} is
# substituted (NGINX_ENVSUBST_FILTER in docker-compose.prod.yml); nginx's own
# $variables must survive untouched.

upstream whatsapp_ai_bot {
    server app:8000;
}

# WebSocket upgrades need Connection: upgrade passed through, but the same
# header must be "close" for ordinary requests, so it cannot be hard-coded.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------------------
# Port 80 -- ACME challenges only, everything else redirected.
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Certbot's webroot plugin drops its challenge files here. This must stay
    # on plain HTTP and must NOT be redirected: renewal has to work before a
    # certificate exists, and on the very first issuance there is nothing on
    # 443 to redirect to yet.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # No security headers here on purpose. HSTS over plain HTTP is ignored by
    # browsers by specification, and anything else is wasted on a 301.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Port 443 -- the only way in.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate         /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;

    include /etc/nginx/tls.conf;
    include /etc/nginx/security-headers.conf;

    client_max_body_size 10m;

    # Do not advertise the nginx patch version to a scanner.
    server_tokens off;

    # Prometheus metrics are never reachable from outside. Prometheus scrapes
    # app:8000/metrics directly over the private compose network; the app also
    # enforces this itself (see require_metrics_access) -- this is the outer of
    # the two layers. 404 rather than 403 so the endpoint's existence is not
    # advertised.
    location /metrics {
        return 404;
    }

    # Renewals reuse http-01 over port 80, but leaving this here means a
    # --force-renewal that follows the redirect still resolves.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # The dashboard's realtime event stream, now over WSS. Long-lived by
    # design, so the default 60s read timeout would drop it roughly every
    # minute; the app sends a heartbeat every 20s, well inside this window.
    location /ws/ {
        include /etc/nginx/security-headers.conf;

        proxy_pass http://whatsapp_ai_bot;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The app trusts this to know the request arrived over TLS. It is set
        # from $scheme, not passed through, so a client cannot forge it.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Meta posts webhook deliveries here. Nothing about the proxying changes
    # under TLS -- the signature is computed over the raw body, which nginx
    # does not touch.
    location / {
        include /etc/nginx/security-headers.conf;

        proxy_pass http://whatsapp_ai_bot;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
