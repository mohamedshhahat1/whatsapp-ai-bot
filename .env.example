# Local development configuration ONLY.
#
# This file is never read when ENVIRONMENT=production: production credentials
# must come from Docker secrets (/run/secrets/<name>), <NAME>_FILE variables,
# Vault, or the process environment. See docs/SECRETS.md.

# Application
APP_NAME=whatsapp-ai-bot
ENVIRONMENT=development
DEBUG=true

# Database (asyncpg driver for the app; Alembic derives its own sync URL)
# The image must ship the pgvector extension: pgvector/pgvector:pg16
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/whatsapp_ai_bot

# Redis -----------------------------------------------------------------------
# Local development runs Redis WITHOUT a password and that is fine: nothing is
# published outside the compose network. Production is different -- Redis holds
# the queue, the spend counters and the reply-idempotency keys, so the app
# refuses to boot without authentication when ENVIRONMENT=production.
# See docs/REDIS_SECURITY.md.
REDIS_URL=redis://redis:6379/0
# Merged into REDIS_URL and both Celery URLs by app/config.py, percent-encoded.
# In production this arrives as the Docker secret /run/secrets/redis_password
# rather than as a variable -- keeping it out of `docker inspect`.
REDIS_PASSWORD=
# Only needed for a Redis 6+ ACL account other than `default`.
REDIS_USERNAME=
# Switches redis:// to rediss:// everywhere. Turn on ONLY when Redis is reached
# across a network the compose bridge does not cover (a managed instance, or a
# separate host). In-stack traffic never leaves the Docker network, so TLS
# there is pure overhead on every queue operation.
REDIS_TLS=false
# Escape hatch for the production boot check. Setting this to false means
# running the spend ceiling and duplicate-reply protection on an open
# datastore. Understand that before you use it.
REDIS_AUTH_REQUIRED=true

# Background queue (Celery). Broker/backend default to REDIS_URL when empty.
# Set USE_TASK_QUEUE=false to process webhooks in-process (dev only).
USE_TASK_QUEUE=true
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Celery timing ---------------------------------------------------------------
# Redis has no broker-side ack, so kombu re-delivers any task not finished
# within the visibility timeout -- WHILE the first worker is still running it.
# Keep this comfortably above CELERY_TASK_TIME_LIMIT or every slow message is
# processed twice and the customer is answered twice.
CELERY_VISIBILITY_TIMEOUT=900
# Soft limit raises inside the task so it can clean up and be retried; the hard
# limit kills the thread. Without them a wedged socket holds a worker thread
# forever and the worker keeps passing its healthcheck while processing nothing.
CELERY_TASK_SOFT_TIME_LIMIT=240
# MUST stay below the worker's stop_grace_period in docker-compose.prod.yml
# (currently 330s). If Docker SIGKILLs a task mid-flight, task_acks_late means
# it is redelivered -- and redelivery after a WhatsApp send is a duplicate
# reply. Change one, change the other.
CELERY_TASK_TIME_LIMIT=300

# How long a generated reply stays cached against its inbound message id, so a
# retry replays the answer instead of buying a second one from OpenAI.
REPLY_IDEMPOTENCY_TTL_SECONDS=86400

# Rate limiting (Redis-backed, shared across replicas)
RATE_LIMIT_ENABLED=true
# Endpoint ceiling for the webhook, NOT per-customer fairness. Every delivery
# arrives from Meta's infrastructure, so this is a single shared bucket by
# construction -- throttling it drops innocent customers alongside an abuser.
# Deliberately set far above real traffic; it exists only to blunt a broken
# sender or a flood of unsigned junk. Real per-customer limits are below.
RATE_LIMIT_WEBHOOK=6000/minute
RATE_LIMIT_ADMIN=60/minute
# How many reverse proxies sit in front of the app and append to
# X-Forwarded-For. Only the last N entries are trustworthy; the rest are
# client-supplied and forgeable. 1 = the bundled nginx. Set to 0 when nothing
# proxies the app. Getting this too high lets a client forge its own rate
# limit bucket.
TRUSTED_PROXY_HOPS=1

# Per-customer quotas (app/core/quota.py) -------------------------------------
# Keyed on WhatsApp number, enforced inside the worker once the payload has
# been parsed and its signature verified -- the earliest point at which the
# sender is actually known. Sliding windows over a single sorted set, so the
# minute, hour and day figures never disagree at a boundary.
#
# A blocked customer's messages are still stored and still shown to operators.
# We decline to answer; we never decline to listen.
CUSTOMER_RATE_LIMIT_ENABLED=true
CUSTOMER_LIMIT_PER_MINUTE=12
CUSTOMER_LIMIT_PER_HOUR=120
CUSTOMER_LIMIT_PER_DAY=400

# Abuse detection. A burst faster than a person can type, or the same text
# repeated, earns a temporary block rather than a reply to every message.
# Note these are heuristics: a real customer sending six photos of a damaged
# ceiling trips the flood rule. Operators can lift a block immediately with
# POST /admin/customers/{wa_id}/unblock.
FLOOD_BURST_MESSAGES=5
FLOOD_BURST_SECONDS=10
DUPLICATE_MESSAGE_LIMIT=5
DUPLICATE_MESSAGE_WINDOW_SECONDS=300
ABUSE_BLOCK_SECONDS=900

# Spend circuit breaker -------------------------------------------------------
# Global daily ceilings across all customers. When either is reached the model
# stops being called for everyone and customers are routed to a person.
# Set DAILY_SPEND_LIMIT_USD to an amount you would be content to lose to a
# scripted flood before anyone notices.
#
# Costed with the fallback prices below rather than the model_pricing table:
# this number exists to trip a breaker in milliseconds on the hot path, not to
# bill anyone. The authoritative figure still comes from ai_logs.
SPEND_GUARD_ENABLED=true
DAILY_SPEND_LIMIT_USD=25.0
DAILY_TOKEN_LIMIT=5000000
# Fraction of the ceiling at which a warning is logged, once per day.
SPEND_ALERT_THRESHOLD=0.8

# Outbound retries (tenacity, exponential backoff with jitter)
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MAX_SECONDS=8

# Reliability: webhook deliveries that exhaust every Celery retry are pushed
# onto this capped Redis list instead of disappearing. Inspect with:
#   docker compose exec redis redis-cli lrange webhooks:dead-letter 0 -1
DEAD_LETTER_KEY=webhooks:dead-letter
DEAD_LETTER_MAX_ENTRIES=1000

# Observability (Prometheus /metrics on the API; worker serves port 9100)
# /metrics is not public: in-cluster scrapes are allowed, anything arriving
# through the proxy must present ADMIN_API_KEY.
METRICS_ENABLED=true
WORKER_METRICS_PORT=9100
# USD per 1M tokens. FALLBACK ONLY: real costs come from the model_pricing
# table (see docs/PRICING.md), which is what keeps historical figures correct
# when a price changes. These are used only for a model with no pricing row,
# and by the spend guard above.
OPENAI_INPUT_PRICE_PER_1M=0.40
OPENAI_OUTPUT_PRICE_PER_1M=1.60

# Secret backends -------------------------------------------------------------
# Directory holding Docker secrets; files are named after the setting,
# e.g. /run/secrets/openai_api_key
SECRETS_DIR=/run/secrets
# Any setting can also be loaded from a file with the _FILE suffix:
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# DATABASE_URL_FILE=/run/secrets/database_url
# HashiCorp Vault (KV v2) - disabled by default
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=
# VAULT_TOKEN_FILE=/run/secrets/vault_token
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# Knowledge base / RAG --------------------------------------------------------
# Documents in KNOWLEDGE_DIR are chunked, embedded and searched with pgvector.
# Index them with: python scripts/ingest_knowledge.py   (see docs/RAG.md)
RAG_ENABLED=true
KNOWLEDGE_DIR=knowledge
# Ingestion and retrieval must use the SAME embedding model.
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column width created by migration 0001_knowledge_base.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
# Chunking: larger chunks carry more context but match less precisely.
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
# Retrieval: how many chunks to inject, and the cosine similarity floor.
# Below the floor nothing is injected and the bot says it does not know,
# rather than answering from a weak match.
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_MAX_CONTEXT_CHARS=6000

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini
# The assistant's persona lives in app/services/persona.py: version
# controlled, code reviewed, and the source of the approved Arabic welcome.
# Leave SYSTEM_PROMPT unset to use it. Uncommenting the line below REPLACES
# the persona entirely -- do that only when reusing this codebase for a
# different business. See docs/PERSONA.md.
# SYSTEM_PROMPT=
# Optional: injected into the structured prompt as a dedicated section
COMPANY_INFO=
MAX_OUTPUT_TOKENS=512
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_TOKENS=6000

##############################################################################
# Conversation Session
##############################################################################
# A session is one complete visit: welcome, questions, goodbye. Every duration
# and every behaviour below is configuration -- there are no timeouts in the
# code. See docs/SESSION_LIFECYCLE.md.
#
# REQUIRES THE `beat` CONTAINER. Sessions are opened, greeted and tracked by
# the app and worker, but only the scheduler triggers the sweep that closes
# them. Without beat running, no closing message is ever sent and every
# conversation stays open -- silently, with every healthcheck still green.

# The master switch. Off, nothing below runs: no welcome is tracked, no
# session is ever closed, and conversations behave exactly as they did before
# this feature existed -- one endless thread per customer. That is what makes
# it a way to disable the lifecycle in an incident without a rollback.
ENABLE_CONVERSATION_SESSION=true

# How long a conversation may sit with no activity in EITHER direction before
# it is considered idle. Not just silence from the customer: a reply still
# being generated counts as activity, so a slow answer is never overtaken by a
# goodbye. Swept once a minute, so the real delay is up to a minute more than
# this. Below about 2 the bot starts saying goodbye to people mid-thought.
CONVERSATION_IDLE_TIMEOUT_MINUTES=5

# Whether going idle ends the session at all. Off, the timer still runs and
# the state is still reported as WAITING_IDLE, but nothing is ever closed.
# Distinct from the next setting: this one governs CLOSING, that one governs
# only the MESSAGE.
CONVERSATION_CLOSE_AFTER_IDLE=true

# Turning this off still closes idle sessions on schedule -- so the next
# message opens a fresh one and is greeted -- it just does it silently.
ENABLE_CONVERSATION_CLOSING_MESSAGE=true

# The grace period after a session closes. A customer who writes back within
# this many minutes resumes the SAME conversation: same history, no second
# welcome. A goodbye followed thirty seconds later by "sorry, one more thing"
# is one conversation, and greeting them again would read as though the bot
# had forgotten them. Set to 0 to make every closed session final.
CONVERSATION_REOPEN_WINDOW_MINUTES=30

# Past this many hours a returning customer always starts a genuinely new
# session, whatever the reopen window says. It is the outer bound on how stale
# a resumed conversation may be, and the reopen window is clamped to it: a
# longer window would let someone returning next week land in last week's
# thread and be answered in the context of a finished job.
#
# Unrelated to Meta's 24-hour customer service window, which is a platform
# rule rather than a preference and is NOT configurable (see
# CUSTOMER_SERVICE_WINDOW in app/services/reply_service.py). They share a
# number today by coincidence; changing this one does not move that one.
NEW_SESSION_AFTER_HOURS=24

# Whether a new session greets its customer at all. Off, conversations simply
# begin with an answer to whatever was asked.
ENABLE_WELCOME_ON_NEW_SESSION=true

# Whether a RETURNING customer whose previous session was closed is greeted
# again. Off means the welcome is sent once per customer, ever -- however long
# they have been away. The setting above is the master switch; this one is
# only about repeat visits.
ENABLE_REPEAT_WELCOME_AFTER_NEW_SESSION=true

# The duplicate guards. Both default on and both should stay on: they are what
# make "exactly one welcome and one goodbye per session" true, and turning
# either off permits a redelivered webhook or an overlapping sweep to message
# the customer twice.
PREVENT_DUPLICATE_WELCOME=true
PREVENT_DUPLICATE_CLOSING=true

# Whether outgoing messages reset the idle timer as well as incoming ones. On
# -- the default, and strongly recommended -- the timer measures silence in
# the conversation. Off, it measures silence from the CUSTOMER alone, so a
# slow completion or a long operator reply can be overtaken by the sweeper.
RESET_IDLE_TIMER_ON_OUTGOING_MESSAGE=true

# Overrides the approved Arabic closing copy in app/services/persona.py, the
# same way SYSTEM_PROMPT overrides the persona. Leave it empty to use that
# copy: it is multi-line text a customer reads, which belongs in version
# control where it can be reviewed, not in a .env value that cannot hold a
# newline without escaping games. Set it only when reusing this codebase for
# another business, or to switch the closing language -- and note that a
# multi-line value must be quoted and will be read literally, newlines and
# all. To send the English wording instead of the Arabic default:
#
#   CONVERSATION_CLOSING_MESSAGE="Thank you for contacting Al Kayan
#   Construction & Finishing. Have a wonderful day."
#
CONVERSATION_CLOSING_MESSAGE=
##############################################################################

# Business identity -----------------------------------------------------------
# Used by the persona, the out-of-scope reply, and the pricing deflection.
COMPANY_NAME=
# Company website and portfolio URLs. When configured, the bot directs
# customers asking about designs, examples or previous work to these links
# instead of saying it has none. If COMPANY_PORTFOLIO_URL is empty, the bot
# falls back to COMPANY_WEBSITE. If both are empty, the portfolio section is
# omitted from the prompt entirely.
COMPANY_WEBSITE=https://example.com
COMPANY_PORTFOLIO_URL=https://example.com/projects
# The number customers are given whenever a price comes up, and whenever the
# assistant hands over to a person. Leave it empty and the bot asks the
# customer for their number instead -- workable, but it turns an immediate
# connection into a callback, so set it.
# See docs/PRICING_POLICY.md.
SALES_PHONE=

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp)
WHATSAPP_TOKEN=EAAG-your-permanent-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v21.0

# Admin API (also guards /metrics from outside the cluster)
ADMIN_API_KEY=choose-a-strong-random-key

# =============================================================================
# Deployment (docker-compose.prod.yml)
# =============================================================================
# The public hostname. REQUIRED in production -- nginx renders its config from
# it and Let's Encrypt issues against it, so a stack started without it would
# serve a certificate for the wrong name.
DOMAIN=
CERTBOT_EMAIL=
# Image to deploy. Defaults to the :latest tag published by CI.
# APP_IMAGE=ghcr.io/mohamedshhahat1/whatsapp-ai-bot:latest

# =============================================================================
# Local backups (scripts/backup.sh, scripts/backup-scheduler.sh)
# =============================================================================
BACKUP_HOUR=2
RETAIN_DAILY=14
RETAIN_WEEKLY=8
RETAIN_MONTHLY=12
# The backup container's healthcheck measures the AGE OF THE LAST SUCCESS, not
# whether the process is alive. A backup container running happily while
# producing nothing for three days is the failure that matters.
BACKUP_MAX_AGE_HOURS=30

# =============================================================================
# Off-site backups (docs/OFFSITE_BACKUP.md)
# =============================================================================
# Backups on the same server as the database protect against exactly one
# failure: someone dropping a table. They do not survive the disk, the host,
# the provider account, or ransomware -- which are the cases you actually keep
# backups for.
#
# s3 | b2 | gcs | azure | none.  Default none keeps existing deployments
# working unchanged; backup.sh logs a warning each run rather than failing.
BACKUP_REMOTE_PROVIDER=none
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_PREFIX=whatsapp-ai-bot
# Independent, longer retention than local. Off-site storage is cheap and its
# whole purpose is surviving something that destroys the local copies.
RETAIN_REMOTE_DAILY=30
RETAIN_REMOTE_WEEKLY=12
RETAIN_REMOTE_MONTHLY=24
# Exponential backoff with jitter. Object storage fails transiently; a single
# attempt turns a five-second network blip into a missing day of backups.
BACKUP_REMOTE_RETRY_ATTEMPTS=5
BACKUP_REMOTE_RETRY_BASE_SECONDS=3
BACKUP_REMOTE_RETRY_MAX_SECONDS=60
# Age at which backup-verify-remote.sh declares the newest off-site copy stale.
BACKUP_REMOTE_MAX_AGE_HOURS=30

# Encryption. Uploads are encrypted BEFORE they leave the host and the script
# REFUSES to upload an unencrypted dump -- these files contain every customer
# conversation. Set one of the two.
#
# Passphrase mode: openssl aes-256-cbc, PBKDF2, 200k iterations.
BACKUP_ENCRYPTION_PASSPHRASE=
# Public-key mode (age) -- preferred: the server can create backups it cannot
# itself decrypt, so a compromised host cannot read its own backup history.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
# Compress before encrypting. Encrypted data does not compress, so the order
# matters; off by default because pg_dump already compresses at level 9.
BACKUP_COMPRESS_BEFORE_ENCRYPT=false

# --- AWS S3 and Backblaze B2 (S3-compatible) ---------------------------------
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=us-east-1
# Leave empty for AWS. For B2 use the S3-compatible endpoint shown in your
# bucket details, of the form s3.<region>.backblazeb2.com (with https://).
BACKUP_S3_ENDPOINT=
# e.g. STANDARD_IA or GLACIER_IR. Note that Glacier tiers have retrieval
# latency -- do not use them for the daily tier the restore drill reads.
BACKUP_S3_STORAGE_CLASS=

# --- Google Cloud Storage ----------------------------------------------------
BACKUP_GCS_CREDENTIALS_FILE=
BACKUP_GCS_PROJECT=

# --- Azure Blob Storage ------------------------------------------------------
BACKUP_AZURE_ACCOUNT=
# Prefer a SAS token scoped to this container over the account key.
BACKUP_AZURE_SAS_TOKEN=
BACKUP_AZURE_ACCOUNT_KEY=

# Where backup-metrics.sh writes .prom files for the node-exporter textfile
# collector. This is how backup state reaches Prometheus and the alerts.
BACKUP_METRICS_DIR=/backups/metrics
# Where backup-download.sh places retrieved objects.
BACKUP_DOWNLOAD_DIR=

# =============================================================================
# Restore drill (scripts/restore-drill.sh, docs/BACKUP_RESTORE.md)
# =============================================================================
# A backup that has never been restored is a hypothesis, not a backup.
RESTORE_DRILL_ENABLED=true
# How often the scheduler runs a full drill, in days.
RESTORE_DRILL_DAYS=7
RESTORE_DRILL_DB=restore_drill
RESTORE_DRILL_IMAGE=pgvector/pgvector:pg16
# Bound to 127.0.0.1; must not collide with the real database port.
RESTORE_DRILL_PORT=55432
RESTORE_DRILL_APP_PORT=58000
RESTORE_DRILL_PASSWORD=drillpass
# Needed for the migration and application-startup steps. Defaults to
# APP_IMAGE; without it the drill still verifies the restore but skips
# steps 4 and 10-11.
RESTORE_DRILL_APP_IMAGE=
RESTORE_DRILL_TABLES=users conversations messages ai_logs documents model_pricing

# =============================================================================
# Alerting (docs/ALERTING.md)
# =============================================================================
# WARNING: do NOT put these in this file in production.
#
# Alertmanager has no environment expansion of its own, so its config is
# rendered by envsubst at container start from the SHELL environment. Put these
# in a root-owned 0600 file and source it before `docker compose up`. They are
# visible via `docker inspect` on the alertmanager-config init container --
# an accepted limitation, documented rather than hidden.
#
# Configure at least one channel. Configure two if you want to be woken up:
# a critical alert about the server being down cannot be delivered by anything
# hosted on that server.

# --- Telegram (fastest to set up: talk to @BotFather, then @userinfobot) -----
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Slack (Incoming Webhook) ------------------------------------------------
ALERT_SLACK_WEBHOOK_URL=
ALERT_SLACK_CHANNEL=#alerts
# Optional split so backup and cost alerts do not drown the main channel.
# Both default to ALERT_SLACK_CHANNEL.
ALERT_SLACK_CHANNEL_BACKUP=
ALERT_SLACK_CHANNEL_COST=

# --- Email -------------------------------------------------------------------
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
