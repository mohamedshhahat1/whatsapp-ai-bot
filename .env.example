# Local development configuration ONLY.
#
# This file is never read when ENVIRONMENT=production: production credentials
# must come from Docker secrets (/run/secrets/<name>), <NAME>_FILE variables,
# Vault, or the process environment. See docs/SECRETS.md.

# Application
APP_NAME=whatsapp-ai-bot
ENVIRONMENT=development
DEBUG=true

# Database (asyncpg driver for the app; Alembic derives its own sync URL)
# The image must ship the pgvector extension: pgvector/pgvector:pg16
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/whatsapp_ai_bot

# Redis
REDIS_URL=redis://redis:6379/0

# Background queue (Celery). Broker/backend default to REDIS_URL when empty.
# Set USE_TASK_QUEUE=false to process webhooks in-process (dev only).
USE_TASK_QUEUE=true
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Rate limiting (Redis-backed, shared across replicas)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WEBHOOK=600/minute
RATE_LIMIT_ADMIN=60/minute

# Outbound retries (tenacity, exponential backoff with jitter)
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MAX_SECONDS=8

# Observability (Prometheus /metrics on the API; worker serves port 9100)
METRICS_ENABLED=true
WORKER_METRICS_PORT=9100
# USD per 1M tokens, used for the cost metric (defaults match gpt-4.1-mini)
OPENAI_INPUT_PRICE_PER_1M=0.40
OPENAI_OUTPUT_PRICE_PER_1M=1.60

# Secret backends -------------------------------------------------------------
# Directory holding Docker secrets; files are named after the setting,
# e.g. /run/secrets/openai_api_key
SECRETS_DIR=/run/secrets
# Any setting can also be loaded from a file with the _FILE suffix:
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# DATABASE_URL_FILE=/run/secrets/database_url
# HashiCorp Vault (KV v2) - disabled by default
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=
# VAULT_TOKEN_FILE=/run/secrets/vault_token
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# Knowledge base / RAG --------------------------------------------------------
# Documents in KNOWLEDGE_DIR are chunked, embedded and searched with pgvector.
# Index them with: python scripts/ingest_knowledge.py   (see docs/RAG.md)
RAG_ENABLED=true
KNOWLEDGE_DIR=knowledge
# Ingestion and retrieval must use the SAME embedding model.
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column width created by the migration.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
# Chunking: larger chunks carry more context but match less precisely.
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
# Retrieval: how many chunks to inject, and the cosine similarity floor.
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_MAX_CONTEXT_CHARS=6000

# OpenAI
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini
SYSTEM_PROMPT=You are a helpful WhatsApp assistant for our business.
# Optional: injected into the structured prompt as a dedicated section
COMPANY_INFO=
MAX_OUTPUT_TOKENS=512
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_TOKENS=6000

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp)
WHATSAPP_TOKEN=EAAG-your-permanent-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v21.0

# Admin API
ADMIN_API_KEY=choose-a-strong-random-key
