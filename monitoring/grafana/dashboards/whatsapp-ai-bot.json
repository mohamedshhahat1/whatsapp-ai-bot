{
  "uid": "whatsapp-ai-bot",
  "title": "WhatsApp AI Bot",
  "tags": ["whatsapp", "ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Messages (24h)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(increase(whatsapp_messages_total[24h]))", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Dead-lettered webhooks (24h)",
      "description": "Deliveries that exhausted all Celery retries and were parked in Redis. Anything above zero means a customer message was not answered -- inspect the webhooks:dead-letter list. Spend is deliberately not shown here: cost depends on the price in force at the time, which lives in the model_pricing table, so the admin dashboard is the single source of truth for money.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(webhook_dead_letters_total[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "OpenAI p95 latency (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(openai_response_seconds_bucket[5m])) by (le))", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors (1h)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(increase(app_errors_total[1h]))", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Message rate by direction",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "sum(rate(whatsapp_messages_total[5m])) by (direction)", "legendFormat": "{{direction}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "OpenAI response time (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(openai_response_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(openai_response_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "OpenAI token usage",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "targets": [
        { "expr": "sum(rate(openai_tokens_total[5m])) by (kind)", "legendFormat": "{{kind}}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors by type",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "targets": [
        { "expr": "sum(rate(app_errors_total[5m])) by (type)", "legendFormat": "{{type}}", "refId": "A" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP requests by status",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (status)", "legendFormat": "{{status}}", "refId": "A" }
      ]
    }
  ]
}
